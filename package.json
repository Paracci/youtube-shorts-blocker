{
  "name": "youtube-toolkit",
  "version": "1.16.0",
  "private": true,
  "description": "Test harness and release tooling for Paracci YouTube Toolkit and its native companion",
  "scripts": {
    "test": "node --test test/unit/*.test.js test/integration/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:syntax": "node test/scripts/syntax-check.js",
    "test:all": "npm run test:syntax && npm test",
    "build:update": "node scripts/build-update.js"
  }
}
